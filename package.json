{
  "name": "swagger-route-validator",
  "version": "4.0.0",
  "description": "The fastest openapi validation middleware",
  "main": "bin/index.js",
  "type": "module",
  "keywords": [
    "swagger",
    "validation",
    "express",
    "request",
    "response",
    "openapi"
  ],
  "typings": "./types.d.ts",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "url": "git+https://github.com/fed135/swagger-route-validator.git"
  },
  "husky": {
      "hooks": {
        "pre-push": "npm run lint"
      }
    },
  "scripts": {
    "test": "node --test ./tests/*/*.spec.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "bench:ajv": "node benchmarks/ajv.ts & sleep 3 && ab -c 250 -n 100000 http://localhost:9000/pets/123",
    "bench:srv": "node benchmarks/srv.ts & sleep 3 && ab -c 250 -n 100000 http://localhost:9001/pets/123",
    "bench:sway": "node benchmarks/sway.ts & sleep 3 && ab -c 250 -n 100000 http://localhost:9002/pets/123",
    "bench:validator": "node benchmarks/openapiValidator.ts & sleep 3 && ab -c 250 -n 100000 http://localhost:9003/pets/123",
    "bench": "npm run bench:ajv && npm run bench:validator && npm run bench:srv",
    "build": "rm -rf ./bin && tsc"
  },
  "author": "Frederic Charette <fredericcharette@gmail.com>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.0",
    "@types/eslint": "^9.6.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
		"@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "express": "^5.2.0",
    "express-ajv-middleware": "^2.0.2",
    "express-openapi-validator": "^5.6.0",
    "husky": "^9.1.0",
    "sway": "^2.0.6",
    "typescript": "^6.0.0"
  }
}
