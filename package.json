{
  "name": "swagger-route-validator",
  "version": "4.0.0",
  "description": "The fastest openapi validation middleware",
  "main": "bin/index.js",
  "type": "module",
  "keywords": [
    "swagger",
    "validation",
    "express",
    "request",
    "response",
    "openapi"
  ],
  "typings": "./types.d.ts",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "url": "git+https://github.com/fed135/swagger-route-validator.git"
  },
  "files": [
    "bin",
    "types.d.ts"
  ],
  "husky": {
      "hooks": {
        "pre-push": "npm run lint"
      }
    },
  "scripts": {
    "test": "node --test \"./tests/**/*.spec.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "rm -rf ./bin && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=bin/index.js --target=esnext",
    "bench": "node --experimental-bench --bench benchmarks/regression.ts",
    "prepublishOnly": "npm run build"
  },
  "author": "Frederic Charette <fredericcharette@gmail.com>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.0",
    "@types/eslint": "^9.6.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
		"@typescript-eslint/parser": "^8.71.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild":"^0.28.2",
    "eslint": "^10.11.0",
    "express": "^5.2.0",
    "husky": "^9.1.0"
  }
}
